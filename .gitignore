# Secrets and credentials (Rule 4)
*.key.txt
*.secret
*.pem
*.p12
*.pfx
.env
.env.*
credentials*

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Models (large binary files)
models/*.hef
models/*.tflite
models/*.onnx
models/*.pt
models/*.bin
models/*.weights
# BirdNET labels ship with the CC BY-NC-SA model package and are
# downloaded by scripts/download_models.sh, not committed.
models/BirdNET_*
!models/.gitkeep

# Media output
output/
clips/
thumbnails/

# Runtime data directory (database, clips, thumbnails, audio clips)
data/

# SQLite databases
*.db
*.db-journal
*.db-wal

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
desktop.ini

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Training artifacts
datasets/
runs/
training/cache/
*.pt
wandb/

# Claude Code local state (machine-specific, not shared)
.claude/settings.local.json
.claude/projects/

# HailoRT runtime logs (dropped in repo root by the driver)
hailort.log
hailort.*.log

# Ultralytics weights downloaded to repo root
/yolo*.pt
