# Secrets and credentials (Rule 4)
*.key.txt
*.secret
*.pem
*.p12
*.pfx
.env
.env.*
credentials*

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Models (large binary files)
models/*.hef
models/*.tflite
models/*.onnx
models/*.pt
models/*.bin
models/*.weights
# Hailo INT8 calibration set -- hundreds of MB of raw uint8 image data,
# rebuildable from the training images with training/build_calibration_set.py
models/*.npy
# Hailo DFC intermediates (translated network + quantized params)
models/*.har
# The same binaries one level down. Each detector generation keeps its
# ONNX, HEF, HAR and calibration set in models/vN/ so two generations
# can be compared, and a pattern anchored at models/ does not reach them.
models/*/*.hef
models/*/*.onnx
models/*/*.pt
models/*/*.npy
models/*/*.har
# BirdNET labels ship with the CC BY-NC-SA model package and are
# downloaded by scripts/download_models.sh, not committed.
models/BirdNET_*
!models/.gitkeep

# Panel firmware build tree.
#
# .arduino/ holds arduino-cli, the ESP32 core and ArduinoJson, all
# fetched by scripts/build_panel_firmware.sh. The EPD*/spi* files are
# Elecrow's e-paper driver, downloaded from their repository at build
# time for the same reason the BirdNET weights are: the terms stay with
# their author rather than being vendored here.
firmware/.arduino/
firmware/build/
firmware/ratcatcher_panel/EPD.h
firmware/ratcatcher_panel/EPD.cpp
firmware/ratcatcher_panel/EPD_Init.h
firmware/ratcatcher_panel/EPD_Init.cpp
firmware/ratcatcher_panel/EPDfont.h
firmware/ratcatcher_panel/spi.h
firmware/ratcatcher_panel/spi.cpp

# Media output
output/
clips/
thumbnails/

# Runtime data directory (database, clips, thumbnails, audio clips)
data/

# SQLite databases
*.db
*.db-journal
*.db-wal

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
desktop.ini

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Training artifacts
datasets/
runs/
training/cache/
*.pt
wandb/

# Claude Code local state (machine-specific, not shared)
.claude/settings.local.json
.claude/projects/

# HailoRT runtime logs (dropped in repo root by the driver)
hailort.log
hailort.*.log

# Ultralytics weights downloaded to repo root
/yolo*.pt
